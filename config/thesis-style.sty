\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/thesis-style}[2026/09/18 Ecology--algorithmics thesis style]

% Engine and typography -------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{mathpazo}
  \RequirePackage[scaled=0.92]{helvet}
  \RequirePackage{courier}
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  \defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
  \setmainfont{EBGaramond-Variable.ttf}[
    Path=assets/fonts/,
    ItalicFont=EBGaramond-Italic-Variable.ttf,
    BoldFont=EBGaramond-Variable.ttf,
    BoldItalicFont=EBGaramond-Italic-Variable.ttf,
    BoldFeatures={RawFeature={axis={wght=700}}},
    BoldItalicFeatures={RawFeature={axis={wght=700}}}
  ]
  \setsansfont{TeX Gyre Heros}
  \setmonofont{Latin Modern Mono}
  \setmathfont{TeX Gyre Pagella Math}
\fi
\RequirePackage[final,tracking=true,kerning=true]{microtype}
\RequirePackage[english]{babel}
\RequirePackage{csquotes}

% Page and heading design -----------------------------------------------------
\KOMAoptions{DIV=12,BCOR=8mm,headinclude=true,footinclude=false}
\recalctypearea
\RequirePackage{scrlayer-scrpage}
\clearpairofpagestyles
\automark[section]{chapter}
\ihead{\small\headmark}
\ohead{\small\ifdraftmode\textcolor{HabitatOchre}{DRAFT}\else\pagemark\fi}
\ifoot{\small\ifdraftmode\pagemark\fi}
\pagestyle{scrheadings}
\renewcommand*{\chapterpagestyle}{plain.scrheadings}

\RequirePackage{xcolor}
% Shared by the main document and all design entry points.
\newcommand{\colorswatch}[1]{%
  \begingroup
  \setlength{\fboxsep}{0pt}%
  \raisebox{-0.25em}{%
    \fcolorbox{black}{white}{%
      \color[HTML]{#1}\rule{1.4em}{1.4em}%
    }%
  }%
  \endgroup
}
\InputIfFileExists{config/themes/\ThesisDesign.tex}{}{%
  \PackageError{thesis-style}{Unknown thesis design `\ThesisDesign'}%
  {Choose habitat-grid, field-notes, technical-atlas, or quiet-academic.}%
}

\setkomafont{disposition}{\sffamily\bfseries\color{DeepInk}}
\setkomafont{chapter}{\ThemeChapterFont}
\setkomafont{section}{\ThemeSectionFont}
\setkomafont{subsection}{\sffamily\bfseries\color{DeepInk}}
\setkomafont{pageheadfoot}{\sffamily\color{DeepInk}}
\setkomafont{captionlabel}{\sffamily\bfseries\color{HabitatGreen}}
\renewcommand*{\chapterformat}{\ThemeChapterFormat}
\providecommand{\ThemeSetup}{}
\ThemeSetup

% General document tools ------------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{figures/}}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{enumitem}
\setlist[itemize,enumerate]{nosep,leftmargin=*}
\RequirePackage{mathtools}
\RequirePackage{amsthm}
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small,labelfont=bf,format=plain}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,fit,positioning,shapes.geometric}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{xurl}

% References and links --------------------------------------------------------
\RequirePackage[
  backend=biber,
  style=authoryear-comp,
  maxcitenames=2,
  maxbibnames=99,
  giveninits=true,
  uniquename=init,
  doi=true,
  isbn=false,
  url=true,
  sortcites=true
]{biblatex}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=HabitatGreen,
  citecolor=WaterBlue,
  urlcolor=WaterBlue,
  pdfauthor={\ThesisAuthor},
  pdftitle={\ThesisTitle},
  pdfsubject={Master's thesis in movement ecology and algorithm engineering},
  pdfkeywords={animal movement, random walks, MoveApps, utilization distribution, trajectory interpolation}
}
\RequirePackage[nameinlink,noabbrev,capitalise]{cleveref}

% Acronyms --------------------------------------------------------------------
\RequirePackage{acro}
\acsetup{make-links=true,list/display=all,list/name={Acronyms and abbreviations}}
\DeclareAcronym{api}{short=API,long=application programming interface}
\DeclareAcronym{bbmm}{short=BBMM,long=Brownian bridge movement model}
\DeclareAcronym{cpu}{short=CPU,long=central processing unit}
\DeclareAcronym{crs}{short=CRS,long=coordinate reference system}
\DeclareAcronym{dp}{short=DP,long=dynamic programming}
\DeclareAcronym{esa}{short=ESA,long=European Space Agency}
\DeclareAcronym{gps}{short=GPS,long=Global Positioning System}
\DeclareAcronym{gpu}{short=GPU,long=graphics processing unit}
\DeclareAcronym{hmm}{short=HMM,long=hidden Markov model}
\DeclareAcronym{kde}{short=KDE,long=kernel density estimate}
\DeclareAcronym{mcmc}{short=MCMC,long=Markov chain Monte Carlo}
\DeclareAcronym{stac}{short=STAC,long=SpatioTemporal Asset Catalog}
