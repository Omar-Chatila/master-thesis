% Draft prompts ---------------------------------------------------------------
\newcommand{\draftnote}[1]{%
  \ifdraftmode
    \begin{tcolorbox}[
      enhanced,
      breakable,
      colback=MistGreen,
      colframe=HabitatGreen,
      boxrule=0.45pt,
      arc=1.5mm,
      left=2mm,right=2mm,top=1mm,bottom=1mm,
      fonttitle=\sffamily\bfseries,
      title={Writing prompt}
    ]#1\end{tcolorbox}%
  \fi
}
\newcommand{\placeholder}[1]{%
  \ifdraftmode
    \par\smallskip\noindent
    \fcolorbox{HabitatOchre}{SoftGray}{%
      \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule}{\sffamily\small\color{DeepInk}#1}}%
    \par\smallskip
  \fi
}
\newcommand{\qtyvalue}[2]{\ensuremath{#1\,\mathrm{#2}}}
\newcommand{\software}[1]{\textsf{#1}}
\newcommand{\dataset}[1]{\textit{#1}}
\newcommand{\code}[1]{\nolinkurl{#1}}

% Code listings ---------------------------------------------------------------
\lstdefinestyle{thesis}{
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{HabitatGreen},
  commentstyle=\itshape\color{WaterBlue},
  stringstyle=\color{HabitatOchre},
  backgroundcolor=\color{SoftGray},
  frame=single,
  rulecolor=\color{EarthSand},
  breaklines=true,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true
}
\lstset{style=thesis}

% Default title page. Themes may replace the whole layout ---------------------
\newcommand{\DefaultThemeTitlePage}{%
  \begin{titlepage}
    \ThemeCoverBackground

    \sffamily
    \vspace*{1.4cm}
    {\color{HabitatGreen}\bfseries\MakeUppercase{Master's thesis}\par}
    \vspace{1.6cm}
    \parbox{0.96\textwidth}{\raggedright\color{DeepInk}\bfseries\fontsize{27}{32}\selectfont\ThesisTitle\par}\par
    \vspace{0.65cm}
    \parbox{0.92\textwidth}{\raggedright\color{WaterBlue}\fontsize{15}{20}\selectfont\ThesisSubtitle\par}\par
    \vspace{1.2cm}
    {\large\ThesisAuthor\par}
    {\small\color{DeepInk!75}\ThesisAuthorEmail\par}
    \vspace{0.8cm}
    \begin{tabular}{@{}>{\bfseries}p{3.5cm}p{8.5cm}@{}}
      Degree & \ThesisDegree\ in \ThesisProgramme\\[0.25em]
      First examiner & \ThesisFirstExaminer\\
      Second examiner & \ThesisSecondExaminer\\
      Supervisor & \ThesisSupervisor\\
    \end{tabular}\par
    \vspace{0.8cm}
    {\ThesisDepartment\enspace·\enspace\ThesisChair\par}
    {\bfseries\ThesisUniversity\par}
    {\ThesisLocation, \ThesisSubmissionDate\par}
    \vfill
  \end{titlepage}
}
\providecommand{\ThemeTitlePage}{\DefaultThemeTitlePage}
\newcommand{\makethesistitle}{%
  \ThemeTitlePage
  \cleardoublepage
}

